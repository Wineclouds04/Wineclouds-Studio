<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinecloudsStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinecloudsStudio"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Wineclouds Studio"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootLayout">
        <Grid.Resources>
            <Style x:Key="NavigationFluentIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="20" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Background="{ThemeResource TitleBarBackgroundBrush}"
            Title="WinecloudsStudio" />

        <NavigationView
            x:Name="NavigationView"
            Grid.Row="1"
            AlwaysShowHeader="True"
            Background="{ThemeResource NavigationPaneBrush}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="NavigationView_ItemInvoked"
            PaneDisplayMode="Left"
            SelectionFollowsFocus="Enabled">
            <NavigationView.PaneHeader>
                <StackPanel Margin="12,8,0,8">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                        Text="Wineclouds Studio" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{ThemeResource NavigationGroupLabelBrush}"
                        Text="酒云工作台" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <TextBlock
                    x:Name="VersionText"
                    Margin="16,8,12,12"
                    Foreground="{ThemeResource NavigationGroupLabelBrush}"
                    Text="0.1.4-(0)" />
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader
                    Content="工作台"
                    Foreground="{ThemeResource NavigationGroupLabelBrush}" />
                <NavigationViewItem
                    Content="首页"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE80F;"
                            Style="{StaticResource NavigationFluentIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader
                    Content="服务模块"
                    Foreground="{ThemeResource NavigationGroupLabelBrush}" />
                <NavigationViewItem
                    Content="硬件信息"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Tag="system-information">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE7FB;"
                            Style="{StaticResource NavigationFluentIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="窗口管理器"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Tag="module-a">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE7C4;"
                            Style="{StaticResource NavigationFluentIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="屏幕区域检测"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Tag="module-b">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE8FE;"
                            Style="{StaticResource NavigationFluentIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="模块 D"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Tag="module-d">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE7C3;"
                            Style="{StaticResource NavigationFluentIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="模块 E"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Tag="module-e">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE8F1;"
                            Style="{StaticResource NavigationFluentIconStyle}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="软件更新"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Icon="Download"
                    Tag="module-f" />
                <NavigationViewItem
                    Content="设置"
                    Foreground="{ThemeResource NavigationPaneForegroundBrush}"
                    Icon="Setting"
                    Tag="settings" />
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" />
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
