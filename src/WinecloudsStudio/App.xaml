<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinecloudsStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinecloudsStudio">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NavigationPaneBrush" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="NavigationPaneForegroundBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="NavigationGroupLabelBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DBEAFE" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#E0F2FE" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1E3A8A" />
                    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="PlaceholderBorderBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#EFF6FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NavigationPaneBrush" Color="#171717" />
                    <SolidColorBrush x:Key="NavigationPaneForegroundBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="NavigationGroupLabelBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#26344D" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#60A5FA" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#262626" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#93C5FD" />
                    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#111111" />
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#111111" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#242424" />
                    <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="PlaceholderBorderBrush" Color="#52525B" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#172554" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
