<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinecloudsStudio.Modules.Reserved.ModuleF.ModuleFPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource ContentSurfaceBrush}"
    mc:Ignorable="d">

    <Grid Padding="40">
        <ScrollViewer>
            <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="软件更新" />
                    <TextBlock
                        Foreground="#64748B"
                        Text="从 GitHub Releases 检查、下载并安装 Wineclouds Studio 正式版本。" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="#64748B"
                                Text="当前版本" />
                            <TextBlock
                                x:Name="CurrentVersionText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="0.0.0" />
                            <TextBlock
                                Foreground="#94A3B8"
                                Text="本机正在运行的程序版本与构建号" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock
                                    Foreground="#64748B"
                                    Text="GitHub 最新正式版" />
                                <TextBlock
                                    x:Name="LatestVersionText"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="尚未检查" />
                                <TextBlock
                                    x:Name="PublishedAtText"
                                    Foreground="#94A3B8"
                                    Text="点击按钮获取最新版本" />
                            </StackPanel>
                            <ProgressRing
                                x:Name="CheckProgressRing"
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                IsActive="False"
                                Visibility="Collapsed"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Message="正在准备更新服务。"
                    Severity="Informational"
                    Title="软件更新" />

                <Border
                    x:Name="ReleaseDetailsCard"
                    Padding="24"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    x:Name="ReleaseNameText"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="版本信息" />
                                <TextBlock
                                    x:Name="InstallerInfoText"
                                    Foreground="#64748B"
                                    Text="Windows x64 安装包" />
                            </StackPanel>
                            <Button
                                x:Name="OpenReleasePageButton"
                                Grid.Column="1"
                                Click="OpenReleasePageButton_Click"
                                Content="查看 GitHub 发布页"
                                IsEnabled="False" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="版本说明" />
                            <Border
                                MaxHeight="240"
                                Padding="14"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ScrollViewer>
                                    <TextBlock
                                        x:Name="ReleaseNotesText"
                                        Foreground="#334155"
                                        IsTextSelectionEnabled="True"
                                        Text="暂无版本说明。"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            x:Name="DownloadProgressPanel"
                            Spacing="6"
                            Visibility="Collapsed">
                            <ProgressBar
                                x:Name="DownloadProgressBar"
                                Height="6"
                                IsIndeterminate="False"
                                Maximum="100"
                                Minimum="0"
                                Value="0" />
                            <TextBlock
                                x:Name="DownloadProgressText"
                                Foreground="#64748B"
                                Text="准备下载…" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="DownloadAndInstallButton"
                                Click="DownloadAndInstallButton_Click"
                                Content="下载并安装"
                                IsEnabled="False">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#0078D4" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#106EBE" />
                                </Button.Resources>
                            </Button>
                            <Button
                                x:Name="CancelDownloadButton"
                                Click="CancelDownloadButton_Click"
                                Content="取消下载"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="安全更新流程" />
                            <TextBlock
                                Foreground="#64748B"
                                Text="程序只接受 Wineclouds04/Wineclouds-Studio 正式 Release 的 update.json 清单及 Windows x64 安装包，并使用清单中的 SHA-256 摘要完成校验。安装器将在当前程序完全退出后启动。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="CheckUpdatesButton"
                            Grid.Column="1"
                            Click="CheckUpdatesButton_Click"
                            Content="检查更新"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
