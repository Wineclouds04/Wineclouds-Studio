<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinecloudsStudio.Modules.Settings.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ContentSurfaceBrush}"
    mc:Ignorable="d">

    <NavigationView
        x:Name="SettingsNavigation"
        AlwaysShowHeader="False"
        Background="{ThemeResource ContentSurfaceBrush}"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="220"
        PaneDisplayMode="Left"
        SelectionChanged="SettingsNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="通用" />
            <NavigationViewItem
                Content="外观与行为"
                Icon="Setting"
                Tag="general" />
            <NavigationViewItem
                Content="超级调色盘"
                Icon="Highlight"
                Tag="palette" />
            <NavigationViewItemHeader Content="Wineclouds" />
            <NavigationViewItem
                Content="关于 Wineclouds"
                Icon="Help"
                Tag="about" />
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <Grid>
                <ScrollViewer x:Name="GeneralSection">
                    <StackPanel
                        MaxWidth="920"
                        Padding="36"
                        HorizontalAlignment="Stretch"
                        Spacing="22">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Text="通用设置" />
                            <TextBlock
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Text="调整 Wineclouds Studio 的外观与通用行为。" />
                        </StackPanel>

                        <Border
                            Padding="22"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="外观设置" />
                                    <TextBlock
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="选择应用的显示主题。" />
                                </StackPanel>

                                <ListView
                                    x:Name="ThemeOptions"
                                    MaxHeight="126"
                                    IsItemClickEnabled="False"
                                    SelectionChanged="ThemeOptions_SelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListViewItem
                                        Margin="0,0,8,0"
                                        Padding="6"
                                        Tag="light">
                                        <StackPanel Width="112" Spacing="8">
                                            <Border
                                                Height="66"
                                                Background="#F8FAFC"
                                                BorderBrush="#D1D5DB"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#E5E7EB" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="8"
                                                        Spacing="5">
                                                        <Border Width="44" Height="5" HorizontalAlignment="Left" Background="#CBD5E1" CornerRadius="2" />
                                                        <Border Width="58" Height="5" HorizontalAlignment="Left" Background="#E2E8F0" CornerRadius="2" />
                                                        <Border Width="30" Height="8" HorizontalAlignment="Right" Background="#60A5FA" CornerRadius="2" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center" Text="极简白" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem
                                        Margin="0,0,8,0"
                                        Padding="6"
                                        Tag="dark">
                                        <StackPanel Width="112" Spacing="8">
                                            <Border
                                                Height="66"
                                                Background="#18181B"
                                                BorderBrush="#3F3F46"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#27272A" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="8"
                                                        Spacing="5">
                                                        <Border Width="44" Height="5" HorizontalAlignment="Left" Background="#52525B" CornerRadius="2" />
                                                        <Border Width="58" Height="5" HorizontalAlignment="Left" Background="#3F3F46" CornerRadius="2" />
                                                        <Border Width="30" Height="8" HorizontalAlignment="Right" Background="#2563EB" CornerRadius="2" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center" Text="极夜黑" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem Padding="6" Tag="system">
                                        <StackPanel Width="112" Spacing="8">
                                            <Border
                                                Height="66"
                                                BorderBrush="#71717A"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#F8FAFC" />
                                                    <Border Grid.Column="1" Background="#18181B" />
                                                    <Border
                                                        Width="28"
                                                        Height="8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#3B82F6"
                                                        CornerRadius="2" />
                                                </Grid>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center" Text="跟随系统" />
                                        </StackPanel>
                                    </ListViewItem>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="22"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="关闭主窗口时" />
                                    <TextBlock
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="选择点击窗口右上角关闭按钮后的行为。" />
                                </StackPanel>

                                <RadioButtons
                                    x:Name="CloseBehaviorOptions"
                                    SelectionChanged="CloseBehaviorOptions_SelectionChanged">
                                    <RadioButton Tag="tray">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="最小化到系统托盘" />
                                            <TextBlock
                                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                Text="应用继续在后台运行，可从托盘图标恢复或退出。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Tag="exit">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="直接退出应用" />
                                            <TextBlock
                                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                Text="关闭窗口时停止所有模块并退出应用。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                </RadioButtons>
                            </StackPanel>
                        </Border>

                        <InfoBar
                            x:Name="SaveStatusInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Success"
                            Title="设置已保存" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="PaletteSection"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="920"
                        Padding="36"
                        HorizontalAlignment="Stretch"
                        Spacing="22">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Text="超级调色盘" />
                            <TextBlock
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Text="集中管理 Wineclouds 的颜色工具与主题能力。" />
                        </StackPanel>
                        <Border
                            Padding="20"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid ColumnSpacing="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Height="210"
                                    Background="{ThemeResource AppSubtleBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource NavigationPaneBrush}" />
                                        <StackPanel
                                            Margin="18"
                                            VerticalAlignment="Center"
                                            Spacing="12">
                                            <Ellipse
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Left"
                                                Fill="{ThemeResource AppAccentBrush}" />
                                            <Border Width="48" Height="7" HorizontalAlignment="Left" Background="{ThemeResource AppBorderBrush}" CornerRadius="3" />
                                            <Border Width="58" Height="7" HorizontalAlignment="Left" Background="{ThemeResource AppBorderBrush}" CornerRadius="3" />
                                            <Border Width="42" Height="7" HorizontalAlignment="Left" Background="{ThemeResource AppBorderBrush}" CornerRadius="3" />
                                        </StackPanel>
                                        <Grid
                                            Grid.Column="1"
                                            Margin="22"
                                            RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="20" Height="20" Fill="{ThemeResource AppTextTertiaryBrush}" />
                                                <Border Width="74" Height="8" VerticalAlignment="Center" Background="{ThemeResource AppTextTertiaryBrush}" CornerRadius="3" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="10">
                                                <Border Width="104" Height="20" Background="{ThemeResource AppBorderBrush}" CornerRadius="4" />
                                                <Border Width="146" Height="20" Background="{ThemeResource AppTextTertiaryBrush}" CornerRadius="4" />
                                                <Border Width="86" Height="20" HorizontalAlignment="Right" Background="{ThemeResource AppTextSecondaryBrush}" CornerRadius="4" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="实时主题预览" />
                                    <TextBlock
                                        x:Name="PaletteCurrentThemeText"
                                        Foreground="{ThemeResource AppAccentBrush}"
                                        Text="当前：跟随系统" />
                                    <TextBlock
                                        MaxWidth="360"
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="选择下方主题后，整个应用会立即切换并自动保存。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="22"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="默认主题" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="首批预留的 Wineclouds 配色" />
                                </StackPanel>

                                <ListView
                                    x:Name="PaletteThemeOptions"
                                    MaxHeight="156"
                                    SelectionChanged="PaletteThemeOptions_SelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListViewItem
                                        Margin="0,0,10,0"
                                        Padding="7"
                                        Tag="light">
                                        <StackPanel Width="190" Spacing="9">
                                            <Border
                                                Height="92"
                                                Background="#FFFFFF"
                                                BorderBrush="#D1D5DB"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#F1F5F9" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="13"
                                                        Spacing="8">
                                                        <Border Width="78" Height="7" HorizontalAlignment="Left" Background="#CBD5E1" CornerRadius="3" />
                                                        <Border Width="104" Height="7" HorizontalAlignment="Left" Background="#E2E8F0" CornerRadius="3" />
                                                        <Border Width="54" Height="14" HorizontalAlignment="Right" Background="#60A5FA" CornerRadius="3" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="极简白" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                    Text="清爽明亮" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem Padding="7" Tag="dark">
                                        <StackPanel Width="190" Spacing="9">
                                            <Border
                                                Height="92"
                                                Background="#121212"
                                                BorderBrush="#3F3F46"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#1F1F1F" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="13"
                                                        Spacing="8">
                                                        <Border Width="78" Height="7" HorizontalAlignment="Left" Background="#52525B" CornerRadius="3" />
                                                        <Border Width="104" Height="7" HorizontalAlignment="Left" Background="#3F3F46" CornerRadius="3" />
                                                        <Border Width="54" Height="14" HorizontalAlignment="Right" Background="#2563EB" CornerRadius="3" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="极夜黑" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                    Text="沉浸深邃" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ListViewItem>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="18"
                            Background="{ThemeResource AppSubtleBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon
                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                    Glyph="&#xE790;" />
                                <TextBlock
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    Text="更多精品、国风与个性主题已预留，将在后续版本开放。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <InfoBar
                            x:Name="PaletteStatusInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Success"
                            Title="主题已应用" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="AboutSection"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="920"
                        Padding="36"
                        HorizontalAlignment="Stretch"
                        Spacing="22">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Text="关于 Wineclouds" />
                            <TextBlock
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Text="Wineclouds Studio 的版本与项目信息。" />
                        </StackPanel>

                        <Border
                            Padding="20"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture
                                    Width="56"
                                    Height="56"
                                    DisplayName="酒酒的云"
                                    ProfilePicture="ms-appx:///Assets/DeveloperAvatar.png" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="酒酒的云" />
                                    <TextBlock
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="Wineclouds Studio 的开发者！" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    MinWidth="150"
                                    VerticalAlignment="Center"
                                    Click="SponsorButton_Click"
                                    Content="赞助酒酒的云" />
                            </Grid>
                        </Border>

                        <InfoBar
                            x:Name="SponsorInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            Message="赞助渠道暂未配置，后续可以在这里接入你的赞助链接。"
                            Severity="Informational"
                            Title="感谢支持" />

                        <Border
                            Padding="28"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid ColumnSpacing="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="64"
                                    Height="64"
                                    Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Text="Wineclouds Studio" />
                                    <TextBlock
                                        x:Name="AboutVersionText"
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="版本 0.0.0" />
                                    <TextBlock
                                        MaxWidth="680"
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="面向 Windows 多窗口工作流的桌面效率工具。"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Button
                                            Click="OpenProjectPageButton_Click"
                                            Content="打开 GitHub 项目" />
                                        <Button
                                            Click="OpenLicenseButton_Click"
                                            Content="查看 MIT 许可证" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource AppTextTertiaryBrush}"
                            Text="Copyright © 2026 Wineclouds" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Page>
