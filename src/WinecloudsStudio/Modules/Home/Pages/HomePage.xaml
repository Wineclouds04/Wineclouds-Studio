<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinecloudsStudio.Modules.Home.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ContentSurfaceBrush}"
    mc:Ignorable="d">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="*" MinHeight="260" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource AppSubtleBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
            <Grid Padding="36">
                <Viewbox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="Uniform"
                    StretchDirection="DownOnly">
                    <Grid
                        Width="2300"
                        Height="470"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="350" />
                            <RowDefinition Height="120" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="LogoAccentCyanText"
                                Margin="3,3,0,0"
                                FontFamily="Consolas"
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="#0EA5E9"
                                IsHitTestVisible="False"
                                LineHeight="50"
                                Opacity="0.9" />
                            <TextBlock
                                x:Name="LogoAccentAmberText"
                                Margin="-3,-2,0,0"
                                FontFamily="Consolas"
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="#F59E0B"
                                IsHitTestVisible="False"
                                LineHeight="50"
                                Opacity="0.8" />
                            <TextBlock
                                x:Name="LogoText"
                                FontFamily="Consolas"
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                LineHeight="50" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                            <TextBlock
                                x:Name="TaglineAccentCyanText"
                                Margin="2,2,0,0"
                                FontFamily="Consolas"
                                FontSize="27"
                                Foreground="#0EA5E9"
                                IsHitTestVisible="False"
                                Opacity="0.85" />
                            <TextBlock
                                x:Name="TaglineAccentAmberText"
                                Margin="-2,-1,0,0"
                                FontFamily="Consolas"
                                FontSize="27"
                                Foreground="#F59E0B"
                                IsHitTestVisible="False"
                                Opacity="0.75" />
                            <TextBlock
                                x:Name="TaglineText"
                                FontFamily="Consolas"
                                FontSize="27"
                                Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="0,24,0,0"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Text="一体化 Windows 工作台" />
                    <TextBlock
                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                        Text="从硬件概览、多窗口工作流到主题与账号入口，都集中在 Wineclouds Studio。" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="12,7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AppAccentSubtleBrush}"
                    CornerRadius="16">
                    <TextBlock
                        x:Name="VersionText"
                        FontFamily="Consolas"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Text="0.0.0" />
                </Border>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="14"
                RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="18"
                    Background="{ThemeResource AppSubtleBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{ThemeResource AppAccentBrush}"
                            Text="01 / SYSTEM" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="硬件信息" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="快速查看 Windows、处理器、显卡、内存和主要设备。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="18"
                    Background="{ThemeResource AppSubtleBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{ThemeResource AppAccentBrush}"
                            Text="02 / LIVE" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="窗口管理器" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="置顶预览关键窗口，通过分组热键快速切换焦点。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="18"
                    Background="{ThemeResource AppSubtleBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="#D97706"
                            Text="03 / SYNC" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="多窗口同步" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="选择主控窗口，将鼠标与键盘操作同步到目标窗口组。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="18"
                    Background="{ThemeResource AppSubtleBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="#0891B2"
                            Text="04 / WATCH" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="屏幕区域检测" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="监测指定区域的颜色变化，在关键状态出现时提醒。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="18"
                    Background="{ThemeResource AppSubtleBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="#A855F7"
                            Text="05 / PERSONALIZE" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="设置与超级调色盘" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="切换极简白、极夜黑、系统主题和托盘关闭行为。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Padding="18"
                    Background="{ThemeResource AppSubtleBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="#16A34A"
                            Text="06 / ACCOUNT" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="Wineclouds 账号" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="预览登录、注册、找回密码与微信登录交互入口。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
