<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinecloudsStudio.Modules.Login.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ContentSurfaceBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RoundedAccountButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource AppSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        </Style>
        <Style
            x:Key="AccountModeButtonStyle"
            BasedOn="{StaticResource RoundedAccountButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
        </Style>
        <Style
            x:Key="SelectedAccountModeButtonStyle"
            BasedOn="{StaticResource AccountModeButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AppAccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        </Style>
        <Style
            x:Key="PrimaryAccountButtonStyle"
            BasedOn="{StaticResource RoundedAccountButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AppAccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RoundedAccountTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{ThemeResource AppSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        </Style>
        <Style x:Key="RoundedAccountPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{ThemeResource AppSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="40">
        <ScrollViewer>
            <StackPanel
                MaxWidth="1120"
                HorizontalAlignment="Stretch"
                Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="登录" />
                    <TextBlock
                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                        Text="管理你的 Wineclouds 账号信息。" />
                </StackPanel>

                <Border
                    Padding="28"
                    Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="20">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="登录 Wineclouds 账号" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="LoginModeButton"
                                Click="ModeButton_Click"
                                Content="登录"
                                Style="{StaticResource SelectedAccountModeButtonStyle}"
                                Tag="login" />
                            <Button
                                x:Name="RegisterModeButton"
                                Click="ModeButton_Click"
                                Content="注册"
                                Style="{StaticResource AccountModeButtonStyle}"
                                Tag="register" />
                            <Button
                                x:Name="RecoverModeButton"
                                Click="ModeButton_Click"
                                Content="找回密码"
                                Style="{StaticResource AccountModeButtonStyle}"
                                Tag="recover" />
                        </StackPanel>

                        <Grid x:Name="LoginPanel" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    Text="邮箱" />
                                <TextBox
                                    x:Name="LoginEmailBox"
                                    PlaceholderText="demo@example.com"
                                    Style="{StaticResource RoundedAccountTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Spacing="6">
                                <TextBlock
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    Text="密码" />
                                <PasswordBox
                                    x:Name="LoginPasswordBox"
                                    PlaceholderText="至少 8 位密码"
                                    Style="{StaticResource RoundedAccountPasswordBoxStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                Padding="18,8"
                                VerticalAlignment="Bottom"
                                Click="LoginButton_Click"
                                Content="登录"
                                Style="{StaticResource PrimaryAccountButtonStyle}" />
                            <HyperlinkButton
                                Grid.Row="1"
                                Padding="4,0"
                                HorizontalAlignment="Left"
                                Click="ForgotPasswordLink_Click"
                                Content="忘记密码？" />
                        </Grid>

                        <StackPanel
                            x:Name="RegisterPanel"
                            Spacing="14"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="邮箱" />
                                <TextBox
                                    x:Name="RegisterEmailBox"
                                    PlaceholderText="demo@example.com"
                                    Style="{StaticResource RoundedAccountTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="密码" />
                                    <PasswordBox
                                        x:Name="RegisterPasswordBox"
                                        PlaceholderText="至少 8 位密码"
                                        Style="{StaticResource RoundedAccountPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="验证码" />
                                    <TextBox
                                        x:Name="RegisterCodeBox"
                                        MaxLength="6"
                                        PlaceholderText="6 位数字"
                                        Style="{StaticResource RoundedAccountTextBoxStyle}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Padding="18,8"
                                    VerticalAlignment="Bottom"
                                    Click="SendRegisterCodeButton_Click"
                                    Content="发送验证码"
                                    Style="{StaticResource RoundedAccountButtonStyle}" />
                            </Grid>
                            <Button
                                MaxWidth="520"
                                Padding="18,8"
                                HorizontalAlignment="Stretch"
                                Click="RegisterButton_Click"
                                Content="注册并登录"
                                Style="{StaticResource PrimaryAccountButtonStyle}" />

                            <Grid Margin="0,18,0,0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AppBorderBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    Text="其他登录方式" />
                                <Border
                                    Grid.Column="2"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AppBorderBrush}" />
                            </Grid>
                            <Button
                                HorizontalAlignment="Left"
                                Click="WeChatLoginButton_Click"
                                Style="{StaticResource RoundedAccountButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Foreground="#07C160"
                                        Glyph="&#xE8F2;" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="#07C160"
                                        Text="微信登录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel
                            x:Name="RecoverPanel"
                            Spacing="14"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        Text="邮箱" />
                                    <TextBox
                                        x:Name="RecoverEmailBox"
                                        PlaceholderText="注册时使用的邮箱"
                                        Style="{StaticResource RoundedAccountTextBoxStyle}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Padding="18,8"
                                    VerticalAlignment="Bottom"
                                    Click="SendRecoverCodeButton_Click"
                                    Content="发送重置验证码"
                                    Style="{StaticResource PrimaryAccountButtonStyle}" />
                            </Grid>

                            <Grid Margin="0,18,0,0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AppBorderBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    Text="其他登录方式" />
                                <Border
                                    Grid.Column="2"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AppBorderBrush}" />
                            </Grid>
                            <Button
                                HorizontalAlignment="Left"
                                Click="WeChatLoginButton_Click"
                                Style="{StaticResource RoundedAccountButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Foreground="#07C160"
                                        Glyph="&#xE8F2;" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="#07C160"
                                        Text="微信登录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <InfoBar
                            x:Name="AccountStatusInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            CornerRadius="10"
                            Severity="Informational"
                            Title="Wineclouds 账号" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
